{
  "name": "b2c-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ../shared/scripts/prerender.mjs",
    "build:vercel": "vite build --mode staging && node ../shared/scripts/prerender.mjs --mode staging && node ../shared/scripts/vercel-output.mjs --store b2c",
    "lint": "node ../shared/scripts/lint.mjs",
    "preview": "vite preview",
    "build:review": "vite build --mode review && node ../shared/scripts/prerender.mjs --mode review",
    "dev:review": "vite --mode review",
    "test": "node --test ../shared/tests/*.test.mjs",
    "format": "node ../shared/scripts/format.mjs --write",
    "format:check": "node ../shared/scripts/format.mjs --check"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.0",
    "slugify": "1.6.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
